# =============================================================================
# Strucureo WhatsApp Agent Platform — Environment Configuration
# =============================================================================
# Copy to .env and fill in values. Process exits on boot if required vars are missing.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://strucureo:strucureo@127.0.0.1:5432/strucureo
DIRECT_DATABASE_URL=postgresql://strucureo:strucureo@127.0.0.1:5432/strucureo

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# ─── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-opus-5

# ─── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_SECRET=change-me-to-a-random-secret

# ─── Google Calendar (service account) ───────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Firebase (dashboard auth — Strucureo product login) ─────────────────────
# Public browser keys (restricted in Firebase console → App Check / domains).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=whatsappagentcrm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://whatsappagentcrm-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=whatsappagentcrm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=whatsappagentcrm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Connection Pool ────────────────────────────────────────────────────────
# Measured from load testing: 50 concurrent sessions ≈ 15-20 connections
# Rule of thumb: pool_size = (concurrent_sessions * 2) + headroom
# Daemon pool: handles inbound messages + tool calls + DB ops
AGENT_POOL_SIZE=20
# Gateway pool: whatsmeow device store + event processing
GATEWAY_POOL_SIZE=10

# ─── Dev Compose ─────────────────────────────────────────────────────────────
# These are for docker-compose only, not consumed by the app
POSTGRES_USER=strucureo
POSTGRES_PASSWORD=strucureo
POSTGRES_DB=strucureo
