[Unit]
Description=Strucureo Agent Daemon
After=network.target postgresql.service redis.service

[Service]
Type=simple
WorkingDirectory=%h/whatsapp_agent/services/agent-daemon
ExecStart=/usr/bin/env node --import tsx src/index.ts daemon
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
