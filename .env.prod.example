# Strucureo production env — copy to .env.prod on the server, fill secrets.
# NEVER commit .env.prod. Generate secrets with: openssl rand -hex 32

# ─── Postgres (Lightsail-local) ─────────────────────────────────────────────
POSTGRES_USER=strucureo
POSTGRES_PASSWORD=CHANGE-ME-strong-random
POSTGRES_DB=strucureo

# ─── Gateway ────────────────────────────────────────────────────────────────
GATEWAY_SECRET=CHANGE-ME-random-32-bytes-hex
GATEWAY_MAX_SEND_RATE=5
# Only for --profile public (Vercel dashboard reaching the gateway):
# GATEWAY_DOMAIN=gateway.strucureo.com

# ─── LLM (at least one) ─────────────────────────────────────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b

# ─── Google OAuth (dashboard Calendar connect) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST be the Vercel URL in prod (not localhost):
# GOOGLE_REDIRECT_URI=https://<your-app>.vercel.app/api/auth/google/callback

# ─── Daemon pools (2 GB box — do not raise without measuring) ───────────────
AGENT_POOL_SIZE=10
LOG_LEVEL=info

# ─── Dashboard (Vercel env — set these in the Vercel project, NOT here) ─────
# DATABASE_URL / DIRECT_DATABASE_URL — pooled connection string (managed PG
#   recommended so Vercel can reach it; else Lightsail PG with TLS + firewall)
# GATEWAY_URL=https://gateway.strucureo.com  (or http://<lightsail-ip>:8080 via firewall)
# GATEWAY_SECRET=(same value as above)
# NEXT_PUBLIC_FIREBASE_* (same values as local .env)
